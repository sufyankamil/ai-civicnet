# CivicNet Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.

# 🔴 REQUIRED: Supabase Backend (Authentication, Database, Realtime)
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ⚪ DEPRECATED: the app no longer reads GEMINI_API_KEY. All AI calls go through
# the `ai-proxy` Supabase edge function, which keeps the key server-side:
#   supabase secrets set GEMINI_API_KEY=your-gemini-api-key-here
# Get a key from Google AI Studio (https://aistudio.google.com/). Remove this
# line from your local .env (it is bundled into the app) and rotate any key
# that was ever shipped in a build.

# 🟡 RECOMMENDED: Google Maps API (Static Maps Preview Tiles)
# Found in: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ⚪ OPTIONAL: Legacy AES Chat Encryption (32-character key for backwards compatibility)
ENCRYPTION_KEY=my32charsecretkeeperfallback1234

# ⚪ OPTIONAL: RevenueCat public SDK keys (subscriptions). Leave empty to keep
# billing switched off; the app runs normally without them.
# Found in: RevenueCat Dashboard -> Project -> API keys (public SDK keys only).
# The webhook secret is NOT put here: `supabase secrets set REVENUECAT_WEBHOOK_SECRET=...`
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=

# ⚪ OPTIONAL: Emergency SOS button on the home screen. Off by default. Set to
# true only after sql_scripts/sos_schema.sql is applied and the notify-sos edge
# function is deployed (see the steps at the top of sos_schema.sql).
SOS_ENABLED=false
