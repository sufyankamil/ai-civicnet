# CivicNet Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.

# 🔴 REQUIRED: Supabase Backend (Authentication, Database, Realtime)
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 🟡 RECOMMENDED: Google Gemini AI (Vector Embeddings & Smart Task Matching)
# Found in: Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# 🟡 RECOMMENDED: Google Maps API (Static Maps Preview Tiles)
# Found in: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ⚪ OPTIONAL: Legacy AES Chat Encryption (32-character key for backwards compatibility)
ENCRYPTION_KEY=my32charsecretkeeperfallback1234
